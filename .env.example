# Resend (email API) — placeholder only, never commit a real key
# Get yours at https://resend.com/api-keys and put the real value in .env (gitignored)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin dashboard (noonstudio.africa/admin) — set BOTH in the Vercel project settings
# (Settings -> Environment Variables -> Production), then redeploy.
# Password you choose for logging into the dashboard. Pick something long and random.
ADMIN_PASSWORD=change-me-to-a-long-random-password
# GitHub personal access token with repo scope (write access to this repo).
# Saves from the dashboard commit + push to main, and Vercel auto-deploys.
# Optional: GITHUB_BRANCH overrides the branch the dashboard writes to (default: main).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
